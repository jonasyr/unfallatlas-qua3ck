<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Unfallatlas – Notebook-Präsentationen</title>
  <link rel="stylesheet" href="{{ style_href }}">
  <script>(function(){try{var t=localStorage.getItem("unfallatlas-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
  <script src="{{ script_src }}" defer></script>
</head>
<body>
  <header class="presentation-header index-header">
    <div class="header-content">
      <p class="document-kind">Unfallatlas QUA³CK</p>
      <h1>Notebook-Präsentationen</h1>
      {% if generated_at_local %}<p class="source-path">Stand: <time datetime="{{ manifest.generated_at | e }}">{{ generated_at_local }}</time></p>{% endif %}
    </div>
  </header>
  <main class="index-shell">
    {# Canonical QUA³CK phase names (Hagenmeyer et al., KIT); the monogram is
       derived from the entry title, so unknown titles simply omit the name. #}
    {% set phase_names = {
      "Q": "Question",
      "U": "Understanding the Data",
      "A³": "Algorithm — Selection, Application, Adjustment",
      "C": "Conclude & Compare",
      "K": "Knowledge Transfer",
    } %}
    {% for title, rows in sections %}
    <section class="phase-section" aria-labelledby="section-{{ loop.index }}">
      <div class="phase-section-heading">
        <h2 id="section-{{ loop.index }}">{{ title }}</h2>
        {% if title == "Veraltet" %}
        <p class="section-hint">Der Notebook-Inhalt hat sich seit dem letzten HTML-Export geändert; die unten verlinkte Ansicht zeigt noch den Stand des vorigen Exports. Erneut exportieren, um sie zu aktualisieren.</p>
        {% elif title == "Verwaist" %}
        <p class="section-hint">Für diesen Eintrag existiert keine Notebook-Quelldatei mehr im Repository.</p>
        {% endif %}
      </div>
      <ol class="phase-list">
        {% for row in rows %}
        {% set mark = (row.entry.title | replace("Unfallatlas Deutschland", "") | replace("Phase", "") | trim)[:2] | trim %}
        <li class="phase-row" data-state="{{ row.state }}">
          <span class="phase-mark" aria-hidden="true">{{ mark }}</span>
          <div class="phase-row-main">
            <h3 class="phase-row-title">
              {% if row.link %}<a href="{{ row.link }}">{{ row.entry.title }}</a>{% else %}<span>{{ row.entry.title }}</span>{% endif %}
            </h3>
            <p class="phase-row-meta">{% if mark in phase_names %}{{ phase_names[mark] }} · {% endif %}<span class="phase-source">{{ row.entry.source }}</span></p>
          </div>
          <div class="phase-row-side">
            <p class="phase-card-badges">
              <span class="status-pill" data-status="{{ row.entry.status }}">{{ row.entry.status }}</span>
              <span class="state-pill" data-state="{{ row.state }}">{{ row.state }}</span>
            </p>
            {% if row.entry.exported_at_local %}
            <p class="phase-row-export">Export: {{ row.entry.exported_at_local }}</p>
            {% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endfor %}
  </main>
</body>
</html>

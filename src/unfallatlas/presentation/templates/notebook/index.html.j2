{% extends 'basic/index.html.j2' %}

{% block header %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ resources.presentation.title | e }}</title>
  <link rel="stylesheet" href="{{ resources.presentation.style_href | e }}">
  {% for css in resources.inlining.css %}<style>{{ css }}</style>{% endfor %}
  <script>(function(){try{var t=localStorage.getItem("unfallatlas-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
</head>
<body
  data-snapshot-sha256="{{ resources.presentation.snapshot_sha256 | e }}"
  data-plotly-runtime="{{ resources.presentation.plotly_runtime_href | e }}"
  data-mathjax-runtime="{{ resources.presentation.mathjax_runtime_href | e }}"
>
<a class="skip-link" href="#notebook-content">Skip to content</a>
<header class="presentation-header">
  <div class="header-content">
    <a class="back-link" href="{{ resources.presentation.index_href | e }}">&larr; Back to overview</a>
    <p class="document-kind">Unfallatlas Notebook</p>
    <h1>{{ resources.presentation.title | e }}</h1>
    <p class="source-path">{{ resources.presentation.source_path | e }}</p>
    <dl class="metadata-grid">
      <div><dt>Exported</dt><dd>{{ resources.presentation.metadata.exported_at_local | e }}</dd></div>
      <div><dt>Status</dt><dd><span class="status-pill" data-status="{{ resources.presentation.status | e }}">{{ resources.presentation.status | e }}</span></dd></div>
      <div><dt>Warnings</dt><dd>{{ resources.presentation.warning_count }}</dd></div>
      <div><dt>Execution state</dt><dd>{% if resources.presentation.execution_complete %}<span class="state-pill" data-state="fresh">Complete</span>{% else %}<span class="state-pill" data-state="stale">Incomplete</span>{% endif %}</dd></div>
      <div><dt>Cells</dt><dd>{{ resources.presentation.counts.markdown }} Markdown, {{ resources.presentation.counts.code }} code</dd></div>
      <div><dt>Outputs</dt><dd>{{ resources.presentation.counts.code_with_output }} output, {{ resources.presentation.counts.error_outputs }} error output</dd></div>
    </dl>
    <details class="technical-provenance">
      <summary>Technical provenance</summary>
      <dl>
        <div><dt>Repository</dt><dd>{{ resources.presentation.metadata.git.repo_name | e }}</dd></div>
        <div><dt>Commit</dt><dd><code>{{ resources.presentation.metadata.git.short_commit | e }}</code></dd></div>
        <div><dt>Branch</dt><dd>{{ resources.presentation.metadata.git.branch | e }}</dd></div>
        <div><dt>Uncommitted changes</dt><dd>{% if resources.presentation.metadata.git.dirty %}Yes{% else %}No{% endif %}</dd></div>
      </dl>
    </details>
    {% if resources.presentation.findings %}
    {% set has_error_finding = resources.presentation.findings | selectattr("severity", "equalto", "error") | list | length > 0 %}
    <details class="findings"{% if has_error_finding %} open{% endif %}>
      <summary>Export findings ({{ resources.presentation.findings | length }})</summary>
      <ul>
      {% for finding in resources.presentation.findings %}
        <li data-severity="{{ finding.severity | e }}"><strong>{{ finding.code | e }}</strong>: {{ finding.message | e }}</li>
      {% endfor %}
      </ul>
    </details>
    {% endif %}
  </div>
</header>
<div class="presentation-shell">
  <div class="presentation-toolbar" aria-label="View controls">
    <button class="toc-trigger" type="button" data-action="toggle-toc" aria-controls="presentation-toc" aria-expanded="false">Contents</button>
    <button type="button" data-action="show-all-code">Show code</button>
    <button type="button" data-action="hide-all-code">Hide code</button>
    <button type="button" data-action="show-all-output">Show outputs</button>
    <button type="button" data-action="hide-all-output">Hide outputs</button>
    <button type="button" data-action="print">Print</button>
  </div>
  <nav id="presentation-toc" class="toc" aria-label="Table of contents">
    <div class="toc-heading">
      <h2>Contents</h2>
      <button class="toc-close" type="button" data-action="close-toc">Close</button>
    </div>
    {% macro toc_list(nodes) %}
    <ol>
      {% for node in nodes %}
      <li><a class="toc-link" href="#{{ node.anchor | e }}">{{ node.title | e }}</a>{% if node.children %}{{ toc_list(node.children) }}{% endif %}</li>
      {% endfor %}
    </ol>
    {% endmacro %}
    {{ toc_list(resources.presentation.toc | nest_toc) }}
  </nav>
  <main id="notebook-content" class="notebook-main" tabindex="-1">
{% endblock header %}

{% block codecell %}
<article class="notebook-cell code-notebook-cell">
  <div class="cell-card">
{{ super() }}
  </div>
</article>
{% endblock codecell %}

{% block input_group %}
<details class="code-cell">
  <summary aria-expanded="false">Code</summary>
  <div class="code-content">{{ super() }}</div>
</details>
{% endblock input_group %}

{#
  classic/base.html.j2's default `input` block pipes highlight_code() output
  through `clean_html` (bleach + html5lib). html5lib's HTML5 tree-construction
  implicitly inserts a <tbody> around bare <tr>s inside <table> (the shape
  Pygments' linenos="table" formatter emits for the line-number gutter);
  bleach's allowed-tags list omits tbody/thead/th/caption, so it escapes that
  implied tag as literal "&lt;tbody&gt;" text instead of stripping it -
  visibly corrupting every code cell's line-number gutter. cell.source here
  is always plain notebook code text run through Pygments' own escaping, not
  user-controlled raw HTML, so re-sanitizing the already-safe, self-generated
  markup is unnecessary; skip clean_html and keep everything else identical
  to the upstream block.
#}
{% block input %}
<div class="inner_cell">
    <div class="input_area">
{{ cell.source | highlight_code(metadata=cell.metadata) }}
    </div>
</div>
{%- endblock input %}

{% block output_group %}
<details class="output-cell" open>
  <summary aria-expanded="true">Output</summary>
  <div class="output-content">{{ super() }}</div>
</details>
{% endblock output_group %}

{% block markdowncell scoped %}
<section class="notebook-cell markdown-cell rendered_html">
  {% if resources.should_sanitize_html %}
    {% set html_value = cell.source | markdown2html | strip_files_prefix | clean_html %}
  {% else %}
    {% set html_value = cell.source | markdown2html | strip_files_prefix %}
  {% endif %}
  {{ html_value }}
</section>
{% endblock markdowncell %}

{% block data_priority scoped %}
{% set prepared = output.get('metadata', {}).get('unfallatlas_presentation', {}) %}
{% if prepared.get('kind') == 'plotly' %}
<div class="plotly-output"
     id="{{ prepared.chart_id | e }}"
     data-chart-id="{{ prepared.chart_id | e }}"
     data-payload-key="{{ prepared.payload_key | e }}"
     data-asset="{{ prepared.asset_href | e }}"
     data-size-bytes="{{ prepared.size_bytes }}"
     role="img"
     aria-label="Interactive Plotly chart">
  <p class="output-placeholder">Chart loads when opened.</p>
</div>
{% elif prepared.get('kind') == 'image' %}
<figure class="output-image">
  <img src="{{ prepared.asset_href | e }}" alt="Notebook chart" loading="lazy">
</figure>
{% else %}
{{ super() }}
{% endif %}
{% endblock data_priority %}

{% block data_html scoped %}
{% set classified = output.data['text/html'] | classify_html_output %}
{% if classified.kind == 'table' %}
<div class="table-scroll" tabindex="0" aria-label="Table with horizontal scrolling">{{ classified.content }}</div>
{% else %}
<iframe class="sandboxed-output" sandbox="" title="Isolated notebook output" srcdoc="{{ classified.content | e }}"></iframe>
{% endif %}
{% endblock data_html %}

{% block stream_stdout %}
<div class="text-output stream-output stdout-output"><pre>{{ output.text | ansi2html }}</pre></div>
{% endblock stream_stdout %}

{% block stream_stderr %}
<div class="text-output stream-output stderr-output"><pre>{{ output.text | ansi2html }}</pre></div>
{% endblock stream_stderr %}

{% block data_text scoped %}
<div class="text-output"><pre>{{ output.data['text/plain'] | ansi2html }}</pre></div>
{% endblock data_text %}

{% block error %}
<div class="error-output" role="alert"><pre>{{ super() }}</pre></div>
{% endblock error %}

{% block footer %}
  </main>
</div>
<button class="back-to-top" type="button" data-action="back-to-top">Back to top</button>
<p class="sr-only" aria-live="polite" data-status-region></p>
<script src="{{ resources.presentation.script_href | e }}" defer></script>
</body>
</html>
{% endblock footer %}
